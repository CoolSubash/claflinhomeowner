# Copy this file to .env and fill in local values.
# Never commit .env or real secrets.

# --- Environment ---
ENVIRONMENT=

# --- Database ---
# Used directly by the backend (psycopg) and by Alembic for migrations
DATABASE_URL=

# Used by docker-compose to provision the local Postgres container
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Auth ---
JWT_SECRET=
REFRESH_TOKEN_SECRET=

# --- AWS ---
AWS_REGION=
AWS_S3_BUCKET=
AWS_KMS_KEY_ID=

# --- AI ---
AI_API_KEY=

# --- Frontend ---
NEXT_PUBLIC_API_URL=
