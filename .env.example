# Copy this file to .env and fill in local values.
# Never commit .env or real secrets.

# --- Environment ---
ENVIRONMENT=

# --- Database ---
# Used directly by the backend (psycopg) and by Alembic for migrations
DATABASE_URL=

# Used by docker-compose to provision the local Postgres container
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-secret
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# Used only to build the email verification link (app/services/email_verification.py)
FRONTEND_BASE_URL=http://localhost:3000

# --- AWS ---
AWS_REGION=
AWS_S3_BUCKET=
AWS_KMS_KEY_ID=

# --- AI ---
# "anthropic" is the only supported provider today (app/services/ai/).
AI_PROVIDER=anthropic
AI_API_KEY=
# A real, publicly available Anthropic API model id/alias.
AI_MODEL=claude-3-5-sonnet-latest

# --- Frontend ---
# Public/browser-facing API base URL (unused while the frontend proxies
# every backend call through its own Route Handlers - see BACKEND_INTERNAL_URL)
NEXT_PUBLIC_API_URL=

# Server-only: where the Next.js server reaches the FastAPI backend from
# app/api/*/route.ts. Never exposed to the browser (no NEXT_PUBLIC_ prefix).
BACKEND_INTERNAL_URL=http://localhost:8000
