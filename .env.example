# Copy this file to .env and fill in local values.
# Never commit .env or real secrets.

# --- Environment ---
ENVIRONMENT=

# --- Database ---
# Used directly by the backend (psycopg) and by Alembic for migrations
DATABASE_URL=

# Used by docker-compose to provision the local Postgres container
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# Used only to build the email verification link (app/services/email_verification.py)
FRONTEND_BASE_URL=http://localhost:3000

# --- AWS ---
# AWS credentials themselves (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY /
# AWS_SESSION_TOKEN) are never set here or read by this app's own config -
# boto3 picks them up directly from the environment or an IAM role. This
# region is used by the Bedrock AI provider below, and later by S3/KMS
# document storage.
AWS_REGION=
AWS_S3_BUCKET=
AWS_KMS_KEY_ID=

# --- AI ---
# "bedrock" (Claude via AWS Bedrock - uses AWS_REGION above, no API key)
# or "anthropic" (direct Anthropic API - needs AI_API_KEY).
AI_PROVIDER=bedrock
AI_API_KEY=
# Bedrock model id (e.g. anthropic.claude-3-5-sonnet-20241022-v2:0) when
# AI_PROVIDER=bedrock, or a direct-API model alias (e.g.
# claude-3-5-sonnet-latest) when AI_PROVIDER=anthropic - the two use
# different id formats for the same model family.
AI_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0

# --- Frontend ---
# Server-only: where the Next.js server reaches the FastAPI backend from
# app/api/*/route.ts. Never exposed to the browser (no NEXT_PUBLIC_ prefix).
BACKEND_INTERNAL_URL=http://localhost:8000
